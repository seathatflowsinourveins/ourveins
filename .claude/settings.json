{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "skillListingBudgetFraction": 0.03,
  "env": {
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "PYTHON_BIN": "Z:/venvs/claude/Scripts/python.exe",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "CLAUDE_CODE_ENABLE_FINE_GRAINED_TOOL_STREAMING": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS": "300000",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://127.0.0.1:3000/api/public/otel/v1/traces",
    "OTEL_EXPORTER_OTLP_TRACES_PROTOCOL": "http/protobuf",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://127.0.0.1:3000/api/public/otel/v1/metrics",
    "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/protobuf",
    "OTEL_RESOURCE_ATTRIBUTES": "openinference.project.name=eee",
    "OTEL_SEMCONV_STABILITY_OPT_IN": "gen_ai_latest_experimental",
    "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "false",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_USER_PROMPTS": "1",
    "OTEL_SERVICE_NAME": "claude-sota-installed",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "MAX_MCP_OUTPUT_TOKENS": "50000",
    "BASH_MAX_OUTPUT_LENGTH": "100000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "MCP_TOOL_TIMEOUT": "300000",
    "CLAUDE_CODE_EFFORT_LEVEL": "max",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_PLUGIN_KEEP_MARKETPLACE_ON_FAILURE": "1",
    "CLAUDE_CODE_SYNC_PLUGIN_INSTALL": "1",
    "MSYS_NO_PATHCONV": "1",
    "MSYS2_ARG_CONV_EXCL": "*",
    "MSYS2_ENV_CONV_EXCL": "*",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "HOME": "Z:\\claude-sota-installed",
    "USERPROFILE": "Z:\\claude-sota-installed",
    "CLAUDE_PLUGIN_DATA": "Z:\\claude-sota-installed\\.claude\\plugins\\data",
    "GATEGUARD_STATE_DIR": "Z:\\claude-sota-installed\\.claude\\state\\gateguard",
    "AUDIT_ROOT": "Z:\\claude-sota-installed",
    "CLAUDE_MEM_DATA_DIR": "Z:\\claude-sota-installed\\.claude\\plugins\\data\\claude-mem",
    "BASH_ENV": "Z:/claude-sota-installed/.claude/state/bash-home-pin.sh",
    "CLAUDE_BASH_NO_LOGIN": "true",
    "CLAUDE_CODE_PLUGIN_GIT_TIMEOUT_MS": "60000",
    "ECC_DISABLED_HOOKS": "pre:observe,post:observe",
    "MSYS_HOOKS_FORM_GATE_ENFORCE": "1"
  },
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Edit(Z:/claude-sota-installed/.claude/settings.json)",
      "Edit(Z:/claude-sota-installed/CLAUDE.md)",
      "Edit(Z:/claude-sota-installed/docs/sota-installed-manifest.md)",
      "Edit(Z:/claude-sota-installed/docs/install-provenance.md)",
      "Bash(npm install -g *)",
      "Bash(uv tool install *)",
      "Bash(uvx *)",
      "Bash(gh release download *)",
      "Bash(git clone --depth 1 https://github.com/* *)",
      "Bash(docker pull *)",
      "Bash(cargo install *)",
      "Bash(codex exec*)",
      "Bash(codex --version)",
      "Bash(codex resume*)",
      "Bash(codex sessions*)",
      "Bash(codex status*)",
      "Bash(codex result*)",
      "Bash(codex cancel*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(./CLAUDE.local.md)",
      "Read(./tools/eee.local.ps1)",
      "Read(**/.aws/credentials)",
      "Read(**/.ssh/config)",
      "Read(**/.ssh/known_hosts)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.docker/config.json)",
      "Read(**/credentials.json)",
      "Read(**/*.crt)",
      "Read(**/.codex/**)",
      "Read(**/.anthropic/**)",
      "Read(**/AppData/Roaming/Mozilla/Firefox/Profiles/**)",
      "Read(**/AppData/Local/Google/Chrome/User Data/**)",
      "Read(**/AppData/Roaming/Microsoft/Edge/User Data/**)",
      "Read(**/AppData/Local/Microsoft/Edge/User Data/**)",
      "Read(**/Library/Application Support/Firefox/Profiles/**)",
      "Read(**/HKEY_LOCAL_MACHINE/**)",
      "Read(**/HKEY_CURRENT_USER/Software/Microsoft/Windows/CurrentVersion/Run/**)",
      "Bash(curl http://*)",
      "Bash(wget http://*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git merge --no-verify*)",
      "Bash(git rebase --no-verify*)",
      "Bash(git cherry-pick --no-verify*)",
      "Bash(git am --no-verify*)",
      "Bash(git -c core.hooksPath=*)",
      "WebFetch(domain:bit.ly)",
      "WebFetch(domain:tinyurl.com)",
      "WebFetch(domain:t.co)",
      "WebFetch(domain:pastebin.com)",
      "WebFetch(domain:gist.githubusercontent.com)",
      "WebFetch(domain:transfer.sh)",
      "WebFetch(domain:ix.io)",
      "WebFetch(domain:dpaste.org)",
      "WebFetch(domain:0x0.st)",
      "WebFetch(domain:file.io)",
      "WebFetch(domain:catbox.moe)",
      "WebFetch(domain:paste.rs)",
      "WebFetch(domain:hastebin.com)",
      "WebFetch(domain:rentry.co)",
      "WebFetch(domain:webhook.site)",
      "WebFetch(domain:*.ngrok.app)",
      "WebFetch(domain:*.ngrok.io)",
      "WebFetch(domain:serveo.net)",
      "WebFetch(domain:localtunnel.me)"
    ],
    "defaultMode": "default"
  },
  "disabledMcpjsonServers": [],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/.claude/hooks/context-mode-cache-heal.mjs\""
          },
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/mcp-env-precheck.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/parallel-guard-userpromptsubmit.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "gitleaks protect --staged --no-banner --redact || exit 2"
          },
          {
            "type": "command",
            "command": "bash -c \"cmd=\\$(jq -r '.tool_input.command // empty'); rc=0; case \\\"\\$cmd\\\" in *'git push'*|*'git commit'*|*'gh pr create'*) trivy fs --quiet --skip-dirs .claude/plugins --skip-dirs node_modules --skip-dirs .git --skip-dirs tmp --skip-dirs .local --severity HIGH,CRITICAL --no-progress --exit-code 1 --scanners vuln . 2>&1 | head -20 >&2 ; rc=\\${PIPESTATUS[0]} ;; esac; exit \\$rc\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash -c \"cmd=\\$(jq -r '.tool_input.command // empty'); case \\\"\\$cmd\\\" in *'--force-with-lease'*) : ;; *'git revert'*|*'git reset --hard'*|*'git push --force'*|*'git push -f '*|*'git push origin +'*|*'git push '*'+refs/'*|*'git -c push.default=force'*|*'git checkout -- '*|*'git checkout --force'*) 'Z:/tools/nodejs/node.exe' 'Z:/claude-sota-installed/.claude/plugins/cache/openai-codex/codex/1.0.4/scripts/codex-companion.mjs' adversarial-review --wait || exit 2 ;; esac; true\"",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"f=\\$(jq -r '.tool_input.file_path // empty'); case \\\"\\$f\\\" in *VERDICT-LEDGER.md|*/verdicts/*) grep -qE '(RE-LITIGATED|RE-AUDIT|HOLDS)' \\\"\\$f\\\" 2>/dev/null && echo 'W317-A Δ34 lint: verify cited row == latest prior row' >&2 ;; esac; exit 0\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/preagent-parallel-guard.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/preagent-subagent-validator.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/preagent-d73-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"f=\\$(jq -r '.tool_input.file_path // .tool_input.filePath // empty'); [ -f \\\"\\$f\\\" ] || exit 0; ext=\\$(echo \\\"\\$f\\\" | tr 'A-Z' 'a-z' | sed 's/.*\\\\.//'); rc=0; case \\\"\\$ext\\\" in py) ruff check --quiet --fix -- \\\"\\$f\\\" 2>&1; rc=\\$?; ruff format --quiet -- \\\"\\$f\\\" 2>&1; [ \\$rc -eq 0 ] || echo \\\"ruff exit=\\$rc on \\$f\\\" >&2;; sh|bash) shellcheck --severity=error -- \\\"\\$f\\\" 2>&1; rc=\\$?; [ \\$rc -eq 0 ] || echo \\\"shellcheck exit=\\$rc on \\$f\\\" >&2;; esac; exit \\$rc\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -WindowStyle Hidden -Command \"try { Add-Content -Path 'Z:/claude-sota-installed/tmp/precompact.log' -Value ((Get-Date -Format o)+'|auto-compact-fired|session='+$env:CLAUDE_SESSION_ID) -ErrorAction Stop } catch { [Console]::Error.WriteLine('PreCompact audit-trail failed: ' + $_.Exception.Message) }; exit 0\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/stop-position-swap.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git worktree prune 2>&1 || echo 'WorktreeRemove: prune failed' >&2"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/subagent-stop-audit.mjs\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"Z:/tools/nodejs/node.exe\" \"Z:/claude-sota-installed/tools/subagent-stop-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -WindowStyle Hidden -Command \"try { [System.Console]::Beep(880,150); [System.Console]::Beep(1100,150) } catch { exit 0 }\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"try { $ev = $input | ConvertFrom-Json -ErrorAction Stop; if ($null -ne $ev -and $ev.error -match 'permission denied|EACCES|gitleaks') { $msg = 'hook-feedback: ' + $ev.error.Substring(0, [Math]::Min($ev.error.Length, 200)); $out = @{ hookSpecificOutput = @{ hookEventName = 'PostToolUseFailure'; additionalContext = $msg } } | ConvertTo-Json -Compress; Write-Output $out } else { exit 0 } } catch { Write-Error \\\"PostToolUseFailure parse: $($_.Exception.Message)\\\"; exit 1 }\"",
            "timeout": 3
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ruff check tools harness --quiet 2>&1; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [],
    "sparsePaths": [],
    "baseRef": "fresh"
  },
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.19 --config Z:/claude-sota-installed/.claude/ccstatusline/settings.json",
    "padding": 0,
    "refreshInterval": 30
  },
