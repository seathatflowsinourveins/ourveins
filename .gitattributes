# W259-v5 L0.4 — Version Control Substrate: line-ending discipline for Windows Z:-portable runtime
# Per LAYER-H-git-vcs-substrate-W259v5.md §11.5 — text undefined across the 6,640-file catalog without this.

* text=auto eol=lf

# Explicit text
*.md   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.sh   text eol=lf

# Windows-native scripts keep CRLF
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary — never touch
*.png   -text
*.jpg   -text
*.jpeg  -text
*.gif   -text
*.pdf   -text
*.zip   -text
*.gz    -text
*.ico   -text
*.woff  -text
*.woff2 -text
*.pyc   -text
