# cognee.env.template — W301 Stream C
# Copy to cognee.env (gitignored) and fill in real values BEFORE `docker compose up`.
# All keys here are public placeholders — NO secrets in template.
#
# Precedence (Compose semantics, https://docs.docker.com/compose/compose-file/05-services/):
#   1. environment: in compose YAML  (HIGHEST)
#   2. env_file: this file
#   3. defaults in image
#
# SEV-1 rotation runbook: ../W301-STREAM-C-DOCKER-COMPOSE-COGNEE-BASIC-MEMORY.md §5

# ---- LLM ----
LLM_PROVIDER=openai
LLM_MODEL=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M
LLM_API_KEY=sk-no-key-required          # host-resident llama-server doesn't auth
# LLM_API_BASE is overridden in compose YAML environment:

# ---- Embeddings (Ollama host) ----
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_API_BASE is overridden in compose YAML environment:

# ---- Vector / Graph / Relational stores ----
VECTOR_DB_PROVIDER=lancedb
GRAPH_DATABASE_PROVIDER=kuzu
DB_PROVIDER=sqlite

# ---- Langfuse observability (SEV-1 SECRET — fill from Langfuse UI) ----
LANGFUSE_PUBLIC_KEY=pk-lf-REPLACE_WITH_REAL_PUBLIC_KEY
LANGFUSE_SECRET_KEY=sk-lf-REPLACE_WITH_REAL_SECRET_KEY
# LANGFUSE_HOST is overridden in compose YAML environment:

# ---- Cognee runtime ----
COGNEE_API_PORT=8000
COGNEE_API_HOST=0.0.0.0
DEBUG=false
