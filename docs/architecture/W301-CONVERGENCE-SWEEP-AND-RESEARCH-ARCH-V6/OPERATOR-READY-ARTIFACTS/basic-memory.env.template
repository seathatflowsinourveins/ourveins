# basic-memory.env.template — W301 Stream C
# Copy to basic-memory.env (gitignored) and fill in real values BEFORE `docker compose up`.
#
# basic-memory has no SEV-1 secrets in env per default config — keys here are
# tunables. Add API keys only if you wire optional remote-backed providers.

# ---- Storage (paths inside container — volumes are named, see compose) ----
BASIC_MEMORY_HOME=/app/data/basic-memory
BASIC_MEMORY_PROJECT_ROOT=/app/data
BASIC_MEMORY_CONFIG_DIR=/app/.basic-memory

# ---- Project ----
BASIC_MEMORY_DEFAULT_PROJECT=main
BASIC_MEMORY_SYNC_CHANGES=true        # real-time file sync (recommended for docker)
BASIC_MEMORY_SYNC_DELAY=1000          # ms

# ---- Logging ----
BASIC_MEMORY_LOG_LEVEL=INFO           # DEBUG for troubleshooting only

# ---- MCP transport (overridden by CMD in upstream Dockerfile; for reference) ----
# basic-memory mcp --transport sse --host 0.0.0.0 --port 8000
