--- a/sdk/cliproxy/auth/conductor.go
+++ b/sdk/cliproxy/auth/conductor.go
@@ -2151,6 +2151,20 @@ func (m *Manager) MarkResult(ctx context.Context, result Result) {
 	if auth, ok := m.auths[result.AuthID]; ok && auth != nil {
 		now := time.Now()
 		auth.recordRecentRequest(now, result.Success)
+
+		// W338 Patch 5: feed breaker + limiter signals.
+		if m.breaker != nil {
+			if result.Success {
+				m.breaker.RecordSuccess(auth.Provider)
+			} else if statusCodeFromResult(result.Error) == 529 {
+				m.breaker.RecordOverload(auth.Provider)
+			}
+		}
+		if m.limiter != nil {
