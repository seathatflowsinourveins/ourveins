# .editorconfig — polyglot defaults for claude-sota-installed
#
# Spec: editorconfig.org v0.16.0 (https://spec.editorconfig.org/)
# Wave: W338 Stream C (per W333.5 Stream 5 §6 design)
# Cardinal: editor-agnostic — VS Code, Vim, Cursor, JetBrains, Sublime all honor.
#
# Coexists with .gitattributes (line-ending authority at checkout time).
# .editorconfig governs in-editor behavior; .gitattributes governs on-disk.
# When they conflict, .gitattributes wins for committed files (e.g. *.ps1 = crlf).

root = true

# ---------------------------------------------------------------------------
# Universal defaults
# ---------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# ---------------------------------------------------------------------------
# Markdown — preserve trailing 2-space line-break syntax; no line cap
# ---------------------------------------------------------------------------
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# ---------------------------------------------------------------------------
# Python — PEP-8 (ruff-default 88 col)
# ---------------------------------------------------------------------------
[*.py]
indent_size = 4
max_line_length = 88

# ---------------------------------------------------------------------------
# Bash / shell — 2 sp, LF (shellcheck-compatible)
# ---------------------------------------------------------------------------
[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

# ---------------------------------------------------------------------------
# PowerShell — 4 sp, CRLF (PSScriptAnalyzer + .gitattributes)
# ---------------------------------------------------------------------------
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

# ---------------------------------------------------------------------------
# Batch / CMD — Windows-native CRLF
# ---------------------------------------------------------------------------
[*.{bat,cmd}]
indent_size = 2
end_of_line = crlf

# ---------------------------------------------------------------------------
# JSON / JSONC — 2 sp
# ---------------------------------------------------------------------------
[*.{json,jsonc}]
indent_size = 2

# ---------------------------------------------------------------------------
# YAML / TOML — 2 sp (YAML strictly requires 2-sp blocks)
# ---------------------------------------------------------------------------
[*.{yml,yaml,toml}]
indent_size = 2

# ---------------------------------------------------------------------------
# JavaScript / TypeScript / Node — 2 sp
# ---------------------------------------------------------------------------
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
max_line_length = 100

# ---------------------------------------------------------------------------
# HTML / CSS / SCSS — 2 sp
# ---------------------------------------------------------------------------
[*.{html,htm,css,scss,sass,less}]
indent_size = 2

# ---------------------------------------------------------------------------
# Makefile — tabs only (POSIX requirement)
# ---------------------------------------------------------------------------
[{Makefile,*.mk}]
indent_style = tab

# ---------------------------------------------------------------------------
# Go — tabs (gofmt invariant)
# ---------------------------------------------------------------------------
[*.go]
indent_style = tab

# ---------------------------------------------------------------------------
# Generated / vendored — DO NOT enforce
# ---------------------------------------------------------------------------
[{**/node_modules/**,**/.claude/plugins/cache/**,**/__pycache__/**,**/dist/**,**/build/**,**/.venv/**,**/venv/**,**/.git/**}]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = unset
