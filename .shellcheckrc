# .shellcheckrc — root-level ShellCheck config (W326-F F-B2)
#
# Cite-anchored: koalaman/shellcheck wiki @ HEAD (deepwiki-ratified 2026-05-19);
# canonical syntax per https://www.shellcheck.net/wiki/.shellcheckrc.
#
# Cardinal-rule compliance: CR-2 (direct upstream-CLI lint config, no project-owned
# hook bodies); CR-4 (operator-curated path-gated config at repo root per CCBP
# claude-settings.md @ ac0d87d). Project-wide; ShellCheck searches upwards from
# the script being linted and finds this file when scripts live under
# Z:/claude-sota-installed/.

# --- Source resolution ---------------------------------------------------------
# Look for source'd files relative to the checked script's directory, then under
# the repo's tools/ helpers dir. Multiple source-path directives accumulate.
source-path=SCRIPTDIR
source-path=SCRIPTDIR/..
source-path=tools

# Allow ShellCheck to open arbitrary 'source'd files — safe in a trusted repo.
external-sources=true

# --- Severity ------------------------------------------------------------------
# Report warning and above. 'style' noise is filtered; 'info' covers most
# correctness hints worth tightening over time.
severity=warning

# --- Optional checks (opt-in per --list-optional) ------------------------------
# Treat unassigned uppercase variables as errors — catches env-var typos in the
# Z:-portable ENV block early. quote-safe-variables flags missing quotes around
# expansions even when current input is safe — defensive hardening.
enable=check-unassigned-uppercase
enable=quote-safe-variables
enable=deprecate-which
enable=avoid-nullary-conditions
enable=require-variable-braces

# --- Disabled checks -----------------------------------------------------------
# SC1091 ("Not following: <file>") — silenced because external-sources resolves
# what it can; remaining cases are intentional cross-shell sources.
disable=SC1091
