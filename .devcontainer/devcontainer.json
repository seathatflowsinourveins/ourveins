{
    "name": "claude-sota-installed",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "22",
            "nodeGypDependencies": true
        },
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.13",
            "installTools": false
        },
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
    },
    "containerEnv": {
        "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1"
    },
    "remoteUser": "vscode",
    "workspaceFolder": "/workspaces/claude-sota-installed",
    "mounts": [
        "source=claude-sota-installed-claudecache,target=/home/vscode/.claude,type=volume",
        "source=claude-sota-installed-node_modules,target=/workspaces/claude-sota-installed/node_modules,type=volume"
    ],
    "postCreateCommand": "if [ -f package.json ]; then npm install --no-audit --no-fund; fi && claude --version || true",
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "ms-python.python",
                "github.vscode-github-actions",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "editor.formatOnSave": false,
                "files.eol": "\n"
            }
        }
    }
}
