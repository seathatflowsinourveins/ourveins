.claude/daemon.status.json

# Temp / state
tmp/
# W349 P0.5(a) RC-2 / W350-SOTA-GIT-TREE — exclude state contents but ALLOW the dir
# to be traversed so we can un-ignore specific files. `.claude/state/` (trailing /)
# would block exceptions inside (gitignore parent-dir exclusion blocks `!file`).
# `.claude/state/*` excludes contents-only; subsequent `!path` re-includes work.
.claude/state/*
!.claude/state/subagent-type-allowlist.json
!.claude/state/claude-md-claim-probes.json
.claude/debug/
.claude/projects/
.claude/sessions/
.claude/agent-memory/
.claude/worktrees/

